{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": [],
    "resolveJsonModule": true,
    "paths": {
      "@shortcutkit/core": ["./node_modules/@shortcutkit/core/src/index.ts"],
      "@shortcutkit/dom": ["./node_modules/@shortcutkit/dom/src/index.ts"],
      "@shortcutkit/react": ["./node_modules/@shortcutkit/react/src/index.ts"]
    }
  },
  "include": ["src", "node_modules/@shortcutkit/core/src/globals.d.ts"]
}
