{
  "name": "circus",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "pnpm install --frozen-lockfile && lefthook install && pnpm run doctor",
    "doctor": "test -d node_modules && test -f ../shortcutkit-js/packages/core/src/index.ts && lefthook validate && test -x \"$(git rev-parse --git-path hooks/pre-commit)\" && test -x \"$(git rev-parse --git-path hooks/pre-push)\" || { echo 'Setup incomplete; run pnpm run setup' >&2; exit 1; }",
    "dev": "vite",
    "dev:fake": "VITE_FAKE_API=1 vite",
    "build": "vite build",
    "tauri": "tauri",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 .",
    "type-check": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "check-all": "pnpm run format:check && pnpm run lint && pnpm run type-check",
    "test": "TZ=Europe/Berlin vitest run --exclude 'src/**/*.perf.test.{ts,tsx}' && TZ=Europe/Berlin vitest run --no-file-parallelism perf.test",
    "test:watch": "TZ=Europe/Berlin vitest"
  },
  "dependencies": {
    "@shortcutkit/core": "link:../shortcutkit-js/packages/core",
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
